<?xml version="1.0" encoding="utf-8"?>
<!-- 中央 PTT 发射态：红色发光环 + 暗红渐变面 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈红色辉光 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#14FF5A5F" />
        </shape>
    </item>
    <item
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp"
        android:left="2dp">
        <shape android:shape="oval">
            <gradient
                android:centerX="0.5"
                android:centerY="0.35"
                android:gradientRadius="70dp"
                android:startColor="#2A1518"
                android:endColor="#140E10"
                android:type="radial" />
            <stroke
                android:width="1.5dp"
                android:color="#73FF5A5F" />
        </shape>
    </item>
    <item
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp"
        android:left="10dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#2EFF5A5F" />
        </shape>
    </item>
</layer-list>
