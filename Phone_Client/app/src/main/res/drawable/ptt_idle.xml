<?xml version="1.0" encoding="utf-8"?>
<!-- 中央 PTT 待机态：径向渐变暗面 + 发丝描边 + 凹槽环 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerX="0.5"
                android:centerY="0.35"
                android:gradientRadius="72dp"
                android:startColor="#1E1E28"
                android:endColor="#121218"
                android:type="radial" />
            <stroke
                android:width="1dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>
    <item
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp"
        android:left="10dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#0DFFFFFF" />
        </shape>
    </item>
</layer-list>
